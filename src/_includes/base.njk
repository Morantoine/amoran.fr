<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}Antoine Moran</title>
  <meta name="description" content="{{ description or 'Antoine Moran, PhD student at CEA-Leti and LIX, working on side-channel attacks against post-quantum cryptography.' }}">
  <link rel="alternate" type="application/atom+xml" href="/blog/feed.xml" title="Antoine Moran — Blog">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Mono:wght@400&display=swap">
  {% if math %}<link rel="stylesheet" href="/katex/katex.min.css">{% endif %}
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <main>
    {% if not home %}
    <nav class="site-nav">
      <a href="/" class="home">amoran.fr</a>
      <a href="/aboutme/"{% if section == "about" %} aria-current="page"{% endif %}>About</a>
      <a href="/blog/"{% if section == "blog" %} aria-current="page"{% endif %}>Blog</a>
    </nav>
    {% endif %}
    {{ content | safe }}
  </main>
</body>
</html>
